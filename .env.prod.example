APP_ENV=prod

# --- API (backend) ---
BOT_API_TOKEN=change-me-bot-api-token
ADMIN_USER_ID=123456789
ADMIN_CHAT_ID=-1003086131623
MINI_APP_CHAT_ID=1258984724
ADMIN_NAME=
MONGO_URL=mongodb://mongo:27017
MONGO_DB=proxmos_bot_prod

PROXMOX_HOST=https://192.168.1.10:8006
PROXMOX_TOKEN_ID=user@pam!bot
PROXMOX_TOKEN_SECRET=change-me-proxmox-secret
PROXMOX_NODE=
PROXMOX_VERIFY_SSL=false
PROTECTED_GUESTS=lxc:100

# --- Bot ---
TELEGRAM_BOT_TOKEN=change-me-telegram-token
TELEGRAM_PROXY_URL=
API_BASE_URL=http://api:8000
WEBAPP_URL=https://your-domain.example/miniapp

# --- Mini App (web service uses same .env.prod) ---
# docker-compose.prod.yml: ports web → 192.168.1.33:3000 (IP хоста для NPM)
# Секреты только здесь; Docker build web не читает .env.prod — переменные подхватываются при старте контейнера.

INIT_DATA_MAX_AGE_SEC=86400
MINI_APP_CHAT_ID=1258984724
# DEV_* не нужны в prod (только локальный браузер при APP_ENV=dev)
